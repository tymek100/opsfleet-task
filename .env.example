# Copy to .env only if it does not already exist; supply your own credentials.
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GEMINI_MODEL=gemini-3.8-flash
THINKING_LEVEL=low
REVIEW_THINKING_LEVEL=medium
DATA_DIR=.retail-agent
# bigquery uses only Google's public TheLook dataset; fixture uses local synthetic rows.
BACKEND=bigquery
# Optional paths (defaults are resolved from the repository):
# FIXTURE_PATH=src/retail_insight/integrations/bigquery/retail_demo.sql
QUESTION_BUDGET_USD=1.0
TURN_TIMEOUT_SECONDS=120
MAX_MODEL_CALLS=12
MAX_TOOL_CALLS=24
MAX_QUERIES=8
MAX_QUERY_BYTES=100000000
MAX_ANSWER_REVIEWS=3
MAX_OUTPUT_TOKENS=4096
REVIEW_OUTPUT_TOKENS=2048
MAX_CONTEXT_BYTES=150000
MAX_REVIEW_BYTES=60000
REVIEW_OVERHEAD_BYTES=12000
REVIEW_RESERVE_SECONDS=30
MODEL_MIN_INTERVAL_SECONDS=0
# Conservative admission rates, not invoice prices. Review for your model/region.
INPUT_USD_PER_MILLION=2.0
OUTPUT_USD_PER_MILLION=12.0
BIGQUERY_USD_PER_TIB=6.25

# Trusted physical warehouse mapping; never supplied by the model.
WAREHOUSE_SOURCE_DATASET=bigquery-public-data.thelook_ecommerce

# Optional: only the distribution agent uses this credential.
# Enable Maps Experience agent tools for its Google Cloud project and API key.
# Leave unset to exercise explicit Maps-unavailable behavior.
# GOOGLE_MAPS_API_KEY=your-maps-api-key

# Azure is a separate connection. Google continues to generate and judge answers.
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_TRACING=false
FOUNDRY_AGENT_ID=retail-insight
TRACE_CONTENT_MODE=metadata
AZURE_AUTH_MODE=default
# Use az login locally, or a managed identity/service principal in Azure.
# AZURE_TENANT_ID=your-project-tenant
# Foundry project access requires Entra ID; this key is for optional Azure inference only.
# AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1
# AZURE_OPENAI_API_KEY=your-azure-model-key
# Set for Docker; without it the local connector discovers the project's connection.
# APPLICATIONINSIGHTS_CONNECTION_STRING=your-linked-application-insights-connection
# AZURE_MONITOR_ENTRA_AUTH=true  # if Application Insights disables local auth
