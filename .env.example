# Copy to .env and supply YOUR credentials. Never commit .env.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
DATA_DIR=.retail-agent
QUESTION_BUDGET_USD=1.0
MAX_QUERY_BYTES=100000000
TURN_TIMEOUT_SECONDS=120
MAX_MODEL_CALLS=6
# Free-tier-friendly spacing; set 0 only if your quota supports it.
MODEL_MIN_INTERVAL_SECONDS=13
MAX_QUERIES=6
# Conservative admission rates; review when changing model or region.
INPUT_USD_PER_MILLION=2.0
OUTPUT_USD_PER_MILLION=12.0
BIGQUERY_USD_PER_TIB=6.25
