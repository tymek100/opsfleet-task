# Copy to .env and supply YOUR credentials. Never commit .env.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GEMINI_API_KEY=your-gemini-api-key
DATA_DIR=.retail-agent
QUESTION_BUDGET_USD=1.0
MAX_QUERY_BYTES=100000000
TURN_TIMEOUT_SECONDS=120
# Optional pacing for constrained quotas; 429 retries honor provider backoff.
MODEL_MIN_INTERVAL_SECONDS=0
MAX_QUERIES=6
# Conservative admission rates; review when changing model or region.
INPUT_USD_PER_MILLION=2.0
OUTPUT_USD_PER_MILLION=12.0
BIGQUERY_USD_PER_TIB=6.25
GEMINI_MODEL=gemini-3.8-flash
THINKING_LEVEL=low
MAX_OUTPUT_TOKENS=4096
MAX_MODEL_CALLS=8
# Analyst, evaluator and provider retries share MAX_MODEL_CALLS and the question budget.
MAX_ANSWER_REVIEWS=3
REVIEW_OUTPUT_TOKENS=2048
MAX_TOOL_CALLS=20
MAX_CONTEXT_BYTES=150000
# Legacy scripts only; the active agent always reviews candidate answers.
COMMENTARY_ENABLED=true
# Conservative admission rates above are not invoice prices.
