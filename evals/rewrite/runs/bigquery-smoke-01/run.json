            "evidence": [
              {
                "sql": "WITH product_stats AS (\n  SELECT\n    product_id,\n    product_name,\n    category,\n    ROUND(SUM(sale_price), 2) AS total_revenue,\n    COUNT(DISTINCT user_id) AS distinct_customers,\n    COUNT(DISTINCT order_id) AS distinct_orders,\n    COUNT(item_id) AS items_sold\n  FROM sales\n  WHERE purchased_at >= '2026-01-01 00:00:00'\n    AND purchased_at < '2026-04-01 00:00:00'\n  GROUP BY product_id, product_name, category\n),\nranked_rev AS (\n  SELECT\n    *,\n    ROW_NUMBER() OVER (ORDER BY total_revenue DESC, distinct_customers DESC, product_id ASC) as rank_rev\n  FROM product_stats\n),\nranked_cust AS (\n  SELECT\n    *,\n    ROW_NUMBER() OVER (ORDER BY distinct_customers DESC, total_revenue DESC, product_id ASC) as rank_cust\n  FROM product_stats\n)\nSELECT\n  'By Revenue' AS ranking_type,\n  rank_rev AS rank,\n  product_id,\n  product_name,\n  category,\n  total_revenue,\n  distinct_customers,\n  distinct_orders,\n  items_sold\nFROM ranked_rev\nWHERE rank_rev <= 5\nUNION ALL\nSELECT\n  'By Distinct Customers' AS ranking_type,\n  rank_cust AS rank,\n  product_id,\n  product_name,\n  category,\n  total_revenue,\n  distinct_customers,\n  distinct_orders,\n  items_sold\nFROM ranked_cust\nWHERE rank_cust <= 5\nORDER BY ranking_type, rank\n",
                "columns": [
