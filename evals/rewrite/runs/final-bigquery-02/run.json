            "evidence": [
              {
                "sql": "WITH base AS (\n  SELECT\n    product_id,\n    product_name,\n    SUM(sale_price) AS total_revenue,\n    COUNT(DISTINCT user_id) AS distinct_customers\n  FROM sales\n  WHERE purchased_at >= '2026-01-01 00:00:00'\n    AND purchased_at < '2026-04-01 00:00:00'\n  GROUP BY product_id, product_name\n),\ntop_rev AS (\n  SELECT\n    'Revenue' AS ranking_type,\n    RANK() OVER (ORDER BY total_revenue DESC) AS rank,\n    product_id,\n    product_name,\n    total_revenue,\n    distinct_customers\n  FROM base\n  QUALIFY rank <= 5\n),\ntop_cust AS (\n  SELECT\n    'Customers' AS ranking_type,\n    RANK() OVER (ORDER BY distinct_customers DESC, total_revenue DESC) AS rank,\n    product_id,\n    product_name,\n    total_revenue,\n    distinct_customers\n  FROM base\n  QUALIFY rank <= 5\n)\nSELECT * FROM top_rev\nUNION ALL\nSELECT * FROM top_cust\nORDER BY ranking_type, rank",
                "columns": [
                  "ranking_type",
                  "rank",
                  "product_id",
                  "product_name",
                  "total_revenue",
                  "distinct_customers"
