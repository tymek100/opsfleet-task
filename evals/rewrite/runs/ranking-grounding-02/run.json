            "evidence": [
              {
                "sql": "WITH q1_sales AS (\n  SELECT\n    product_id,\n    product_name,\n    SUM(sale_price) AS revenue,\n    COUNT(DISTINCT user_id) AS distinct_customers\n  FROM sales\n  WHERE purchased_at >= '2026-01-01'\n    AND purchased_at < '2026-04-01'\n  GROUP BY product_id, product_name\n),\ntop_rev AS (\n  SELECT\n    product_id,\n    product_name,\n    revenue,\n    distinct_customers,\n    ROW_NUMBER() OVER (ORDER BY revenue DESC, product_id ASC) AS rank_rev\n  FROM q1_sales\n),\ntop_cust AS (\n  SELECT\n    product_id,\n    product_name,\n    distinct_customers,\n    revenue,\n    ROW_NUMBER() OVER (ORDER BY distinct_customers DESC, product_id ASC) AS rank_cust\n  FROM q1_sales\n)\nSELECT 'revenue' AS list_type, rank_rev AS rank, product_id, product_name, revenue, distinct_customers\nFROM top_rev\nWHERE rank_rev <= 5\nUNION ALL\nSELECT 'customers' AS list_type, rank_cust AS rank, product_id, product_name, revenue, distinct_customers\nFROM top_cust\nWHERE rank_cust <= 5\nORDER BY list_type, rank",
