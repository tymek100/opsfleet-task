          "prompt": "Show our top five products by revenue and, separately, by distinct customers in Q1 2026. Use two compact tables.",
          "prompt_sha256": {
            "analyst.md": "7e9349b85fd2c75a4f363a0b190f8e1e8f9a22fcc7c99e78aaea8e00f7154cd2",
