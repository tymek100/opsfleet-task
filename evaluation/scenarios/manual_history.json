{
  "description": "Historical assistant-reviewed executions of the same 20 authored conversations. Partial retests are separate experiments, never a replacement full-suite result.",
  "phases": [
    {
      "name": "01 Baseline — 20 conversations",
      "runs": ["manual-baseline-20261122T185628Z-474d7e66", "manual-baseline-20261122T185628Z-eb0aa48e"],
      "reviews": ["baseline-01-05.json", "baseline-06-10.json", "baseline-11-20.json"],
      "expected_turns": 40,
      "expected_verdicts": {"PASS": 29, "PARTIAL": 6, "FAIL": 5}
    },
    {
      "name": "02 First recheck — 20 conversations",
      "runs": ["manual-recheck-20261122T191001Z-bd7d35f6", "manual-recheck-20261122T191001Z-140bf31c"],
      "reviews": ["recheck-01-05.json", "recheck-06-10.json", "recheck-11-20.json"],
      "expected_turns": 40,
      "expected_verdicts": {"PASS": 27, "PARTIAL": 10, "FAIL": 3}
    },
    {
      "name": "03 Second recheck — 20 conversations",
      "runs": ["manual-recheck-20261122T192315Z-46dde6cf", "manual-recheck-20261122T192315Z-95d8af28"],
      "reviews": ["final-01-05.json", "final-06-10.json", "final-11-20.json"],
      "expected_turns": 40,
      "expected_verdicts": {"PASS": 39, "FAIL": 1}
    },
    {
      "name": "04 Targeted retest — rankings and categories (2 of 20)",
      "runs": ["manual-recheck-20261122T193219Z-bc209d40"],
      "reviews": ["targeted-01-03.json"],
      "expected_turns": 4,
      "expected_verdicts": {"PASS": 4}
    },
    {
      "name": "05 Targeted retest — rankings and unsold products (2 of 20)",
      "runs": ["manual-recheck-20261122T193219Z-5cb1ad66"],
      "reviews": ["targeted-01-10.json"],
      "expected_turns": 4,
      "expected_verdicts": {"PASS": 4}
    },
    {
      "name": "06 Targeted retest — rankings (1 of 20)",
      "runs": ["manual-recheck-20261122T193219Z-6c7cc5ef"],
      "reviews": ["targeted-01-third.json"],
      "expected_turns": 2,
      "expected_verdicts": {"PASS": 2}
    }
  ]
}
